#: accounts/forms.py
msgid "Email address"
msgstr "E-Mail-Adresse"

#: accounts/services.py
msgid "Your login link"
msgstr "Dein Anmeldelink"

#: accounts/services.py
#, python-format
msgid ""
"Click the link below to sign in. This link expires in %(minutes)s "
"minutes.\n"
"\n"
"%(link)s\n"
msgstr ""
"Klicke auf den Link, um dich anzumelden. Dieser Link läuft in "
"%(minutes)s Minuten ab.\n"
"\n"
"%(link)s\n"

